@startuml 14-chain-classes
' Лаб. 5 — діаграма класів шаблону Chain of Responsibility: ланцюжок перевірки скрипта
' (пакети вказано відносно ua.kpi.trpz.nantbuilder)
!include _style.iuml
skinparam ranksep 45
skinparam nodesep 30
skinparam classAttributeIconSize 0
hide empty members
set separator none

package "ui" as ui {
  class ScriptEditorForm <<Client>> {
    - checkScript() : void
    - exportScript() : void
  }
  class ValidationReportDialog {
    + ValidationReportDialog(owner : Window,
        issues : List<ValidationIssue>)
  }
}

package "service" as service {
  class ScriptService <<Client>> {
    + saveScript(script : BuildScript) : BuildScript
    + checkScript(script : BuildScript) : List<ValidationIssue>
    + exportScript(script : BuildScript, file : Path) : void
  }
  class ValidationException
}

package "service.validation" as validation {
  class "ScriptValidator {leaf}" as ScriptValidator {
    + ScriptValidator(first : ValidationHandler)
    + {static} standard() : ScriptValidator
    + validate(script : BuildScript) : List<ValidationIssue>
    + {static} hasErrors(issues : List<ValidationIssue>) : boolean
  }
  abstract class ValidationHandler <<Handler>> {
    + setNext(next : ValidationHandler) : ValidationHandler
    + handle(script : BuildScript, issues : List<ValidationIssue>) : void {leaf}
    # {abstract} check(script : BuildScript, issues : List<ValidationIssue>) : boolean
  }
  class ValidationIssue <<record>> {
    + element : String
    + message : String
    --
    + {static} error(element : String, message : String) : ValidationIssue
    + {static} warning(element : String, message : String) : ValidationIssue
  }
  enum Severity {
    ERROR
    WARNING
  }

  class ScriptHeaderValidator <<ConcreteHandler>> {
    # check(…) : boolean
  }
  class PropertyValidator <<ConcreteHandler>> {
    # check(…) : boolean
  }
  class TargetNameValidator <<ConcreteHandler>> {
    # check(…) : boolean
  }
  class DependencyValidator <<ConcreteHandler>> {
    # check(…) : boolean
  }
  class DefaultTargetValidator <<ConcreteHandler>> {
    # check(…) : boolean
  }
  class TaskAttributeValidator <<ConcreteHandler>> {
    # check(…) : boolean
  }

  note left of ValidationHandler
    <b>handle()</b>:
    if (check(script, issues) && next != null)
        next.handle(script, issues);
  end note

  note left of ScriptValidator
    <b>standard()</b> створює обробники
    і з'єднує їх через setNext():
    ScriptHeaderValidator
    → PropertyValidator
    → TargetNameValidator
    → DependencyValidator
    → DefaultTargetValidator
    → TaskAttributeValidator
  end note

  note bottom of TargetNameValidator
    повертає false, якщо назви цілей
    порожні або повторюються, —
    ланцюжок зупиняється
  end note
}

' --- клієнти
ScriptEditorForm --> "- scriptService\n1" ScriptService
ScriptEditorForm .right.> ValidationReportDialog : <<create>>
ScriptEditorForm ..> ScriptValidator : <<use>>\nhasErrors()
ValidationReportDialog ..> ValidationIssue : показує
ScriptService --> "- validator\n1" ScriptValidator
ScriptService .right.> ValidationException : <<throw>>

' --- ланцюжок
ScriptValidator --> "- chain\n1" ValidationHandler
ValidationHandler --> "- next\n0..1" ValidationHandler
ValidationHandler .up.> ValidationIssue : <<use>>
ScriptValidator -[hidden]right- ValidationIssue
ValidationIssue -down-> "+ severity\n1" Severity

' --- конкретні обробники (два ряди по три, у порядку стандартного ланцюжка)
ValidationHandler <|-- ScriptHeaderValidator
ValidationHandler <|-- PropertyValidator
ValidationHandler <|-- TargetNameValidator
ValidationHandler <|-- DependencyValidator
ValidationHandler <|-- DefaultTargetValidator
ValidationHandler <|-- TaskAttributeValidator
ScriptHeaderValidator -[hidden]right- PropertyValidator
PropertyValidator -[hidden]right- TargetNameValidator
ScriptHeaderValidator -[hidden]down- DependencyValidator
PropertyValidator -[hidden]down- DefaultTargetValidator
TargetNameValidator -[hidden]down- TaskAttributeValidator
DependencyValidator -[hidden]right- DefaultTargetValidator
DefaultTargetValidator -[hidden]right- TaskAttributeValidator

@enduml
