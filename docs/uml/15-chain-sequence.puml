@startuml 15-chain-sequence
' Лаб. 5 — діаграма послідовності: «Перевірити скрипт» через ланцюжок обробників (Chain of Responsibility)
!include _style.iuml
hide footbox
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 120

actor "Розробник" as Dev
participant ":ScriptEditorForm" as ED
participant ":ScriptService" as SS
participant ":ScriptValidator" as SV
participant ":ScriptHeader\nValidator" as H1
participant ":Property\nValidator" as H2
participant ":TargetName\nValidator" as H3
participant ":Dependency\nValidator" as H4
participant ":ValidationReport\nDialog" as RD

Dev -> ED : <back:#FFFFFF>натискає «Перевірити»</back>
activate ED
ED -> ED : applyXml(),\nякщо XML змінено
ED -> SS : <back:#FFFFFF>checkScript(script)</back>
activate SS
SS -> SV : <back:#FFFFFF>validate(script)</back>
activate SV
SV -> SV : issues =\nnew ArrayList<>()
SV -> H1 : <back:#FFFFFF>handle(script, issues)</back>
activate H1
H1 -> H1 : check():\nназва, basedir
H1 -> H2 : <back:#FFFFFF>next.handle(…)</back>
activate H2
H2 -> H2 : check():\nвластивості
H2 -> H3 : <back:#FFFFFF>next.handle(…)</back>
activate H3
H3 -> H3 : check():\nназви цілей

alt TargetNameValidator\nзнайшов помилки
  note right of H3
    check() повернув false:
    next.handle() не викликається,
    ланцюжок зупинено
  end note
else <back:#FFFFFF>назви цілей коректні</back>
  H3 -> H4 : <back:#FFFFFF>next.handle(…)</back>
  activate H4
  H4 -> H4 : check():\nзалежності,\nцикли (DFS)
  note right of H4
    далі так само:
    next.handle() →
    DefaultTarget-
    Validator →
    TaskAttribute-
    Validator
  end note
  H4 --> H3
  deactivate H4
end

H3 --> H2
deactivate H3
H2 --> H1
deactivate H2
H1 --> SV
deactivate H1
SV --> SS : <back:#FFFFFF>issues</back>
deactivate SV
SS --> ED : <back:#FFFFFF>issues</back>
deactivate SS

ED -> ED : setStatus(«Перевірку\nзавершено…»)
ED -> RD ** : <back:#FFFFFF>new(this, issues)</back>
ED -> RD : <back:#FFFFFF>setVisible(true)</back>
activate RD
RD --> Dev : <back:#FFFFFF>таблиця проблем і підсумок</back>
Dev -> RD : <back:#FFFFFF>натискає «Закрити»</back>
RD -> RD : dispose()
deactivate RD
deactivate ED

@enduml
