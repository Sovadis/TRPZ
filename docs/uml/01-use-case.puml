@startuml 01-use-case
' Лаб. 2 — діаграма варіантів використання
!include _style.iuml
left to right direction
skinparam ranksep 40
skinparam nodesep 12
skinparam actorFontSize 14
skinparam rectangleFontSize 14
skinparam ArrowFontSize 13
skinparam usecase {
  FontSize 14
}

actor "Розробник" as Dev
actor "NAnt" as NAnt <<зовнішня система>>

rectangle "NAnt Script Builder" {
  usecase "Створити скрипт\nзбірки" as UC1
  usecase "Переглянути\nсписок скриптів" as UC2
  usecase "Редагувати скрипт\nзбірки" as UC3
  usecase "Редагувати\nXML-текст скрипта" as UC4
  usecase "Конструювати скрипт\nперетягуванням" as UC5
  usecase "Підсвічування\nсинтаксису XML" as UC6
  usecase "Автодоповнення\nкоду" as UC7
  usecase "Зберегти скрипт" as UC8
  usecase "Імпортувати\nрішення .sln" as UC9
  usecase "Проаналізувати проєкти\nта залежності" as UC10
  usecase "Експортувати скрипт\nу файл .build" as UC11
  usecase "Видалити скрипт" as UC12
  usecase "Запустити збірку" as UC13
}

Dev -- UC1
Dev -- UC2
Dev -- UC3
Dev -- UC8
Dev -- UC9
Dev -- UC11
Dev -- UC12
Dev -- UC13

UC13 ---- NAnt

UC3 <|-- UC4
UC3 <|-- UC5

UC4 ..> UC6 : <<include>>
UC4 <.. UC7 : <<extend>>
UC9 ..> UC10 : <<include>>

@enduml
