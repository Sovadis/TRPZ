@startuml 12-proxy-classes
' Лаб. 4 — діаграма класів: шаблон Proxy (кешувальний замісник репозиторію заголовків скриптів)
!include _style.iuml
skinparam ranksep 45
skinparam nodesep 55
skinparam classAttributeIconSize 0
hide empty members
set separator none

class NantBuilderApp {
  + {static} main(args : String[]) : void
}

class MainForm {
  + refreshScripts() : void
  + addStatusWidget(widget : JComponent) : void
}

class ScriptService <<Client>> {
  + listScripts() : List<BuildScript>
  + createScript(name : String, description : String,
      baseDir : String) : BuildScript
  + loadScript(id : long) : BuildScript
  + saveScript(script : BuildScript) : BuildScript
  + deleteScript(id : long) : void
}

interface "Repository<T, ID>" as Repository {
  + findById(id : ID) : Optional<T>
  + findAll() : List<T>
  + save(entity : T) : T
  + deleteById(id : ID) : void
}

interface BuildScriptRepository <<Subject>> {
  + findByName(name : String) : Optional<BuildScript>
}

class JdbcBuildScriptRepository <<RealSubject>> {
  + JdbcBuildScriptRepository(db : Database)
  + findById(id : Long) : Optional<BuildScript>
  + findAll() : List<BuildScript>
  + save(entity : BuildScript) : BuildScript
  + deleteById(id : Long) : void
  + findByName(name : String) : Optional<BuildScript>
}

class CachingBuildScriptRepository <<Proxy>> {
  - cache : List<BuildScript>
  --
  + CachingBuildScriptRepository(target : BuildScriptRepository,
      statistics : CacheStatistics)
  + findById(id : Long) : Optional<BuildScript>
  + findAll() : List<BuildScript>
  + save(entity : BuildScript) : BuildScript
  + deleteById(id : Long) : void
  + findByName(name : String) : Optional<BuildScript>
  + invalidate() : void
}

class CacheStatistics {
  - hits : AtomicLong
  - misses : AtomicLong
  - invalidations : AtomicLong
  - listeners : List<Runnable>
  --
  + recordHit() : void
  + recordMiss() : void
  + recordInvalidation() : void
  + addListener(listener : Runnable) : void
}

class CacheStatisticsLabel {
  + CacheStatisticsLabel(statistics : CacheStatistics)
  - onStatisticsChanged() : void
}

class "javax.swing.JComponent" as JComponent
class "javax.swing.JLabel" as JLabel
class Database

note right of NantBuilderApp
  main() створює всі об'єкти діаграми:
  ScriptService отримує замісник замість
  JdbcBuildScriptRepository, а CacheStatisticsLabel
  додається до рядка стану MainForm
end note

' --- шаблон Proxy
ScriptService -[hidden]right- Repository
Repository <|-down- BuildScriptRepository : T = BuildScript\nID = Long
ScriptService -down-> "- scripts\n1" BuildScriptRepository
BuildScriptRepository <|.down. JdbcBuildScriptRepository
CachingBuildScriptRepository -up-> "- target\n1" BuildScriptRepository
BuildScriptRepository <|.down. CachingBuildScriptRepository
JdbcBuildScriptRepository -[hidden]right- CachingBuildScriptRepository
CachingBuildScriptRepository -down-> "- statistics\n1" CacheStatistics
JdbcBuildScriptRepository -down-> "- db\n1" Database

' --- відображення статистики в рядку стану
NantBuilderApp -[hidden]down- MainForm
MainForm -right-> "- scriptService\n1" ScriptService
MainForm o-down- "- statusWidgets\n0..*" JComponent
JLabel -up-|> JComponent
CacheStatisticsLabel -up-|> JLabel
CacheStatisticsLabel -right-> "- statistics\n1" CacheStatistics

@enduml
